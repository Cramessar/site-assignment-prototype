# ---------- PostgreSQL ----------
POSTGRES_DB=site_assignment
POSTGRES_USER=site_assignment
POSTGRES_PASSWORD=change-this-to-a-long-random-password
DATABASE_URL=postgresql+psycopg://site_assignment:change-this-to-a-long-random-password@db:5432/site_assignment

# ---------- Local web binding ----------
SHIFTS_HTTP_PORT=8088

# ---------- Identity ----------
AUTH_MODE=proxy
DEV_USER_EMAIL=supervisor@example.com
IDENTITY_HEADER=cf-access-authenticated-user-email
BOOTSTRAP_ADMINS=
BOOTSTRAP_SUPERVISORS=supervisor@example.com
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# ---------- Existing Ramessar local AI gateway ----------
AI_ENABLED=true
AI_BASE_URL=http://host.docker.internal:3030/v1
AI_API_KEY=rsk_live_replace_me
AI_MODEL=auto
AI_ASSIGNMENT_MODEL=muse-glimmer:latest
AI_TIMEOUT_SECONDS=300
AI_MAX_CONTEXT_CHARS=60000

# ---------- Existing Jira Analytics container ----------
# Shifts does not need Jira credentials. Jira Analytics owns Jira auth,
# report history, and canonical physical-site normalization.
JIRA_ANALYTICS_ENABLED=true
JIRA_ANALYTICS_BASE_URL=http://host.docker.internal:3201
# true: ask Jira Analytics to create a fresh report before the monthly snapshot.
# false: use its most recent saved report.
JIRA_ANALYTICS_REFRESH_REPORT=true
JIRA_ANALYTICS_POLL_SECONDS=5
JIRA_ANALYTICS_MAX_WAIT_SECONDS=1800
JIRA_ANALYTICS_TIMEOUT_SECONDS=60

# Runs on the 1st of each month; worker also catches up after restart.
WORKLOAD_TIMEZONE=America/New_York
WORKLOAD_REFRESH_HOUR=4
