# ---------- PostgreSQL ----------
POSTGRES_DB=site_assignment
POSTGRES_USER=site_assignment
POSTGRES_PASSWORD=change-this-to-a-long-random-password
DATABASE_URL=postgresql+psycopg://site_assignment:change-this-to-a-long-random-password@db:5432/site_assignment

# ---------- Local web binding ----------
# Cloudflare Tunnel should point shifts.ramessar.io at http://localhost:8088
SHIFTS_HTTP_PORT=8088

# ---------- Identity ----------
# Keep dev while building locally. Before company rollout, use proxy mode behind SSO.
AUTH_MODE=dev
DEV_USER_EMAIL=supervisor@example.com
IDENTITY_HEADER=x-user-email
BOOTSTRAP_ADMINS=
BOOTSTRAP_SUPERVISORS=supervisor@example.com
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# ---------- Existing Ramessar local AI gateway ----------
AI_ENABLED=true
AI_BASE_URL=http://host.docker.internal:3030/v1
AI_API_KEY=rsk_live_replace_me
# Can be a real Ollama model or one of your gateway routes such as auto/reasoning/summary.
AI_MODEL=auto
AI_TIMEOUT_SECONDS=300
AI_MAX_CONTEXT_CHARS=60000
