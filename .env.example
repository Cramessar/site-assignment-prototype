# ---------- PostgreSQL ----------
POSTGRES_DB=site_assignment
POSTGRES_USER=site_assignment
POSTGRES_PASSWORD=change-this-to-a-long-random-password
DATABASE_URL=postgresql+psycopg://site_assignment:change-this-to-a-long-random-password@db:5432/site_assignment

# ---------- Local web binding ----------
# Cloudflare Tunnel should point shifts.ramessar.io at http://localhost:8088
SHIFTS_HTTP_PORT=8088

# ---------- Identity ----------
# Public-host safe default: put shifts.ramessar.io behind Cloudflare Access.
AUTH_MODE=proxy
DEV_USER_EMAIL=supervisor@example.com
IDENTITY_HEADER=cf-access-authenticated-user-email
BOOTSTRAP_ADMINS=
BOOTSTRAP_SUPERVISORS=supervisor@example.com
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# ---------- Existing Ramessar local AI gateway ----------
AI_ENABLED=true
AI_BASE_URL=http://host.docker.internal:3030/v1
AI_API_KEY=rsk_live_replace_me
AI_MODEL=auto
# Preferred model for assignment analysis. The app discovers /v1/models and
# falls back to reasoning/auto if this model is unavailable.
AI_ASSIGNMENT_MODEL=muse-glimmer:latest
AI_TIMEOUT_SECONDS=300
AI_MAX_CONTEXT_CHARS=60000

# ---------- Jira rolling 3-month workload ----------
# Disabled until Jira credentials/JQL/site field are configured.
JIRA_ENABLED=false
JIRA_BASE_URL=https://jira.example.com
# cloud = /rest/api/3/search/jql
# data_center = /rest/api/2/search
JIRA_DEPLOYMENT=data_center
# bearer is typical for Data Center PATs; basic uses JIRA_EMAIL + JIRA_API_TOKEN.
JIRA_AUTH_MODE=bearer
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BEARER_TOKEN=
# Base JQL only. The worker automatically appends the previous 3 full months.
# Example: project in (PDN, CSDN) AND issuetype not in (Sub-task)
JIRA_JQL_BASE=
# Jira field that identifies the site, e.g. customfield_12345.
JIRA_SITE_FIELD=
JIRA_PAGE_SIZE=100
JIRA_TIMEOUT_SECONDS=120
JIRA_VERIFY_SSL=true
JIRA_ALIAS_FILE=/app/config/site_aliases.json

# Runs on the 1st of each month. The worker also catches up immediately after a restart.
WORKLOAD_TIMEZONE=America/New_York
WORKLOAD_REFRESH_HOUR=4
